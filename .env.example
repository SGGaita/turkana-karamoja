# WordPress headless CMS
# Local XAMPP: http://localhost/turkana-karamoja-hub
NEXT_PUBLIC_WP_BASE_URL=https://your-wordpress-site.example

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Secret for POST /api/push/broadcast (WP webhook or manual tests)
PUSH_BROADCAST_SECRET=
