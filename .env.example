# WordPress headless CMS
# Local XAMPP: http://localhost/turkana-karamoja-hub
NEXT_PUBLIC_WP_BASE_URL=https://your-wordpress-site.example

# CARTO raster basemaps (Leaflet tiles). Required to avoid the "API key required" watermark.
# Request a free key at https://carto.com/basemaps/apikey — do not commit the real value.
NEXT_PUBLIC_CARTO_API_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Set the same PUSH_BROADCAST_SECRET as TK_HUB_PUSH_SECRET in turkana-headless-hub.php
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
PUSH_BROADCAST_SECRET=

# Set to true to enable the PWA service worker during `next dev` (install/offline testing). Leave unset in production.
NEXT_PUBLIC_PWA_DEV=
